{
  "name": "faster-stacked-tabs",
  "version": "1.0.0",
  "description": "Makes stacked-tab switching faster while preserving its sliding animation.",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "stacked-tabs"
  ],
  "author": "Ben Hancock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhancock/faster-stacked-tabs.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "0.14.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "1.8.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
